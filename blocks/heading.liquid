{%- style -%}
  .ssky-text-block__heading-{{block.id}} {
    color:{{ block.settings.custom_color }};
    margin-top: {{ block.settings.margin_top | times: 0.75 | round: 0 }}px;
    margin-bottom: {{ block.settings.margin_bottom | times: 0.75 | round: 0 }}px;
  }  
  @media screen and (min-width: 750px) {
    .ssky-text-block__heading-{{block.id}} {
      margin-top: {{ block.settings.margin_top }}px;
      margin-bottom: {{ block.settings.margin_bottom }}px;
    }
  }
  {% if block.settings.custom_css != blank %}
    {% assign tt_css = '.ssky-text-block__heading-' | append: block.id %}
    {{ block.settings.custom_css | replace: '[TT_CSS]', tt_css }}
  {% endif %}
{%- endstyle -%}
{%- assign heading_length = block.settings.heading | size -%}
<{{ block.settings.heading_tag }}
  class="ssky-text-block__heading ssky-text-block__heading-{{block.id}} rte {{ block.settings.heading_size }} {{ block.settings.alignment }} weight-{{ block.settings.heading_weight }}{%- if heading_length > 40 %} ssky-text-block__heading--long{%- endif -%}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}" {{ block.shopify_attributes }}>
  {{ block.settings.heading }}
</{{ block.settings.heading_tag }}>

{% schema %}
  {
    "name": "Heading",
    "settings": [
      {
        "type": "richtext",
        "id": "heading",
        "label": "t:sections.ssky_text_block.blocks.heading.settings.heading.label",
        "default": "t:sections.ssky_text_block.blocks.heading.settings.heading.default"
      },
      {
        "type": "color",
        "id": "custom_color",
        "label": "Custom text color"
      },
      {
        "type": "select",
        "id": "alignment",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "center",
            "label": "Center"
          },
          {
            "value": "right",
            "label": "Right"
          }
        ],
        "label": "Text alignment"
      },
      {
        "type": "select",
        "id": "heading_size",
        "options": [
          {
            "value": "h4",
            "label": "t:sections.all.heading_size.options__0.label"
          },
          {
            "value": "h3",
            "label": "t:sections.all.heading_size.options__1.label"
          },
          {
            "value": "h2",
            "label": "t:sections.all.heading_size.options__2.label"
          },
          {
            "value": "h1",
            "label": "t:sections.all.heading_size.options__3.label"
          },
          {
            "value": "h0",
            "label": "t:sections.all.heading_size.options__4.label"
          },
          {
            "value": "hxl",
            "label": "t:sections.all.heading_size.options__5.label"
          }
        ],
        "default": "h1",
        "label": "t:sections.all.heading_size.label"
      },
      {
        "type": "select",
        "id": "heading_weight",
        "options": [
          {
            "value": "medium",
            "label": "t:sections.all.heading_weight.options__1.label"
          },
          {
            "value": "semibold",
            "label": "t:sections.all.heading_weight.options__2.label"
          },
          {
            "value": "bold",
            "label": "t:sections.all.heading_weight.options__3.label"
          }
        ],
        "default": "bold",
        "label": "t:sections.all.heading_weight.label"
      },
      {
        "type": "select",
        "id": "heading_tag",
        "options": [
          {
            "value": "h1",
            "label": "H1"
          },
          {
            "value": "h2",
            "label": "H2"
          },
          {
            "value": "h3",
            "label": "H3"
          },
          {
            "value": "h4",
            "label": "H4"
          },
          {
            "value": "h5",
            "label": "H5"
          },
          {
            "value": "h6",
            "label": "H6"
          }
        ],
        "default": "h2",
        "label": "Heading tag"
      },
      {
        "type": "range",
        "id": "margin_top",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_top",
        "default": 20
      },
      {
        "type": "range",
        "id": "margin_bottom",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_bottom",
        "default": 20
      },
      {
        "type": "liquid",
        "id": "custom_css",
        "label": "Custom CSS",
        "info": "Always use prefix [TT_CSS] for every CSS example [TT_CSS] .class {margin: 0}. [TT_CSS] will generate block dynamic ID"
      }
    ],
    "presets": [
      { "name": "Heading" }
    ]
  }
{% endschema %}